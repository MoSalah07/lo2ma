# Copy to backend/.env for local development. Every variable starts with LO2MA_.

# dev, test or prod. Production hides /docs and /openapi.json.
LO2MA_ENVIRONMENT=dev

# The local database from compose.yaml (`npm run db:up`). The tests use lo2ma_test on the same server.
LO2MA_DATABASE_URL=postgresql+psycopg://lo2ma:lo2ma@127.0.0.1:5432/lo2ma
