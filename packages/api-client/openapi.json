  "components": {
    "schemas": {
      "AdminChallenge": {
        "properties": {
          "challenge": {
            "type": "string",
            "title": "Challenge"
          }
        },
        "type": "object",
        "required": [
          "challenge"
        ],
        "title": "AdminChallenge",
        "description": "What the password step hands back for the code step (adminChallengeSchema)."
      },
      "AdminSignIn": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "AdminSignIn",
        "description": "The password step (adminSignInSchema)."
      },
      "AdminUser": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "email": {
            "type": "string",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "email"
        ],
        "title": "AdminUser",
        "description": "The signed-in admin (adminUserSchema)."
      },
      "AdminVerify": {
        "properties": {
          "challenge": {
            "type": "string",
            "title": "Challenge"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "challenge",
          "code"
        ],
        "title": "AdminVerify",
        "description": "The code step: the challenge and the authenticator's code (adminVerifySchema)."
      },
      "AllCustomers": {
        "properties": {
          "type": {
            "type": "string",
            "const": "all",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "type"
        ],
        "title": "AllCustomers"
      },
      "AmountOff": {
        "properties": {
          "type": {
            "type": "string",
            "const": "amount",
            "title": "Type"
          },
          "value": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Value"
          }
        },
        "type": "object",
        "required": [
          "type",
          "value"
        ],
        "title": "AmountOff"
      },
      "AnyCalories": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "any",
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "AnyCalories"
      },
      "AroundCalories": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "around",
            "title": "Mode"
          },
          "kcal": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Kcal"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "kcal"
        ],
        "title": "AroundCalories"
      },
      "Company": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "$ref": "#/components/schemas/LocalizedText"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "Company",
        "description": "A company, by its id and its name in both languages (companySchema)."
      },
      "CompanyChoice": {
        "properties": {
          "type": {
            "type": "string",
            "const": "company",
            "title": "Type"
          },
          "companyId": {
            "type": "string",
            "title": "Companyid"
          }
        },
        "type": "object",
        "required": [
          "type",
          "companyId"
        ],
        "title": "CompanyChoice",
        "description": "One company's people, as the form picks it: by id."
      },
      "CompanyCustomers": {
        "properties": {
          "type": {
            "type": "string",
            "const": "company",
            "title": "Type"
          },
          "company": {
            "$ref": "#/components/schemas/Company"
          }
        },
        "type": "object",
        "required": [
          "type",
          "company"
        ],
        "title": "CompanyCustomers",
        "description": "One company's people, as the dashboard shows it: with the name."
      },
      "Coupon": {
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z0-9]{4,16}$",
            "title": "Code"
          },
          "discount": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/PercentOff"
              },
              {
                "$ref": "#/components/schemas/AmountOff"
              }
            ],
            "title": "Discount",
            "discriminator": {
              "propertyName": "type",
              "mapping": {
                "amount": "#/components/schemas/AmountOff",
                "percent": "#/components/schemas/PercentOff"
              }
            }
          },
          "minOrder": {
            "type": "integer",
            "minimum": 10000.0,
            "title": "Minorder"
          },
          "limit": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit"
          },
          "perCustomer": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Percustomer"
          },
          "endsOn": {
            "type": "string",
            "format": "date",
            "title": "Endson"
          },
          "audience": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AllCustomers"
              },
              {
                "$ref": "#/components/schemas/NewCustomers"
              },
              {
                "$ref": "#/components/schemas/CompanyCustomers"
              }
            ],
            "title": "Audience",
            "discriminator": {
              "propertyName": "type",
              "mapping": {
                "all": "#/components/schemas/AllCustomers",
                "company": "#/components/schemas/CompanyCustomers",
                "new": "#/components/schemas/NewCustomers"
              }
            }
          },
          "used": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Used"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "paused",
              "ended"
