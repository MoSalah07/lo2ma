{
  "openapi": "3.1.0",
  "info": {
    "title": "Lo2ma API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/auth/otp": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Request Code",
        "operationId": "request_code",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpSent"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-invalid-code": "invalid_destination"
      }
    },
    "/api/auth/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Verify Code",
        "operationId": "verify_code",
        "parameters": [
          {
            "name": "__Host-lo2ma_guest",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Host-Lo2Ma Guest"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerify"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionUser"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Read Session",
        "operationId": "read_session",
        "parameters": [
          {
            "name": "__Host-lo2ma_session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Host-Lo2Ma Session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionUser"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-out": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign Out",
        "operationId": "sign_out",
        "parameters": [
          {
            "name": "__Host-lo2ma_session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Host-Lo2Ma Session"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/places/suggested": {
      "get": {
        "tags": [
          "places"
        ],
        "summary": "Suggested Places",
        "operationId": "suggested_places",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Place"
                  },
                  "type": "array",
                  "title": "Response Suggested Places"
                }
              }
            }
          }
        }
      }
    },
    "/api/places/search": {
      "get": {
        "tags": [
          "places"
        ],
        "summary": "Search Places",
        "operationId": "search_places",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Place"
                  },
                  "title": "Response Search Places"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/places/reverse": {
      "get": {
        "tags": [
          "places"
        ],
        "summary": "Reverse Place",
        "operationId": "reverse_place",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90,
              "minimum": -90,
              "title": "Lat"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180,
              "minimum": -180,
              "title": "Lng"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PointLookup"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-invalid-code": "invalid_point"
      }
    },
    "/api/prefs": {
      "get": {
        "tags": [
          "prefs"
        ],
        "summary": "Read Prefs",
        "operationId": "read_prefs",
        "parameters": [
          {
            "name": "__Host-lo2ma_guest",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Host-Lo2Ma Guest"
            }
          },
          {
            "name": "__Host-lo2ma_session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Host-Lo2Ma Session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPrefs"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "prefs"
        ],
        "summary": "Update Prefs",
        "operationId": "update_prefs",
        "parameters": [
          {
            "name": "__Host-lo2ma_guest",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Host-Lo2Ma Guest"
            }
          },
          {
            "name": "__Host-lo2ma_session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Host-Lo2Ma Session"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserPrefs"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPrefs"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "x-invalid-code": "invalid_prefs"
      }
    }
  },
  "components": {
    "schemas": {
      "AnyCalories": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "any",
            "title": "Mode"
          }
        },
        "type": "object",
        "required": [
          "mode"
        ],
        "title": "AnyCalories"
      },
      "AroundCalories": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "around",
            "title": "Mode"
          },
          "kcal": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Kcal"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "kcal"
        ],
        "title": "AroundCalories"
      },
      "FitCalories": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "fit",
            "title": "Mode"
          },
          "goal": {
            "type": "string",
            "enum": [
              "cut",
              "keep",
              "bulk"
            ],
            "title": "Goal"
          },
          "kcal": {
            "type": "integer",
            "maximum": 1500.0,
            "minimum": 300.0,
            "title": "Kcal"
          },
          "protein": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 10.0,
            "title": "Protein"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "kcal",
          "protein"
        ],
        "title": "FitCalories",
        "description": "«وضع الفورمة»: a lunch goal in calories and protein, within the steppers' limits."
      },
      "GeoPoint": {
        "properties": {
          "lat": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat"
          },
          "lng": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lng"
          }
        },
        "type": "object",
        "required": [
          "lat",
          "lng"
        ],
        "title": "GeoPoint",
        "description": "A point in degrees, WGS 84 (geoPointSchema)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LocalizedText": {
        "properties": {
          "ar": {
            "type": "string",
            "minLength": 1,
            "title": "Ar"
          },
          "en": {
            "type": "string",
            "minLength": 1,
            "title": "En"
          }
        },
        "type": "object",
        "required": [
          "ar",
          "en"
        ],
        "title": "LocalizedText",
        "description": "Text in both languages, such as a place's name (localizedTextSchema)."
      },
      "OtpRequest": {
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "phone",
              "email"
            ],
            "title": "Channel"
          },
          "destination": {
            "type": "string",
            "minLength": 1,
            "title": "Destination"
          }
        },
        "type": "object",
        "required": [
          "channel",
          "destination"
        ],
        "title": "OtpRequest",
        "description": "Where to send a sign-in code (otpRequestSchema)."
      },
      "OtpSent": {
        "properties": {
          "expiresIn": {
            "type": "integer",
            "title": "Expiresin"
          }
        },
        "type": "object",
        "required": [
          "expiresIn"
        ],
        "title": "OtpSent",
        "description": "How long the code works, in seconds."
      },
      "OtpVerify": {
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "phone",
              "email"
            ],
            "title": "Channel"
          },
          "destination": {
            "type": "string",
            "minLength": 1,
            "title": "Destination"
          },
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "channel",
          "destination",
          "code"
        ],
        "title": "OtpVerify",
        "description": "The code the user typed (otpVerifySchema)."
      },
      "Place": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "area": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "point": {
            "$ref": "#/components/schemas/GeoPoint"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "area",
          "point"
        ],
        "title": "Place",
        "description": "A place the location search knows: an office building, a business park or a district.\n\nplaceSchema in packages/core."
      },
      "PointLookup": {
        "properties": {
          "name": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "area": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "inServiceArea": {
            "type": "boolean",
            "title": "Inservicearea"
          }
        },
        "type": "object",
        "required": [
          "name",
          "area",
          "inServiceArea"
        ],
        "title": "PointLookup",
        "description": "What is at a point on the map, and whether Lo2ma delivers there (pointLookupSchema)."
      },
      "SessionUser": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "phone": {
            "type": "string",
            "title": "Phone"
          },
          "email": {
            "type": "string",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "SessionUser",
        "description": "The signed-in user (sessionUserSchema)."
      },
      "UnderCalories": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "under",
            "title": "Mode"
          },
          "kcal": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Kcal"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "kcal"
        ],
        "title": "UnderCalories"
      },
      "UserPrefs": {
        "properties": {
          "workplace": {
            "$ref": "#/components/schemas/Workplace"
          },
          "breakTime": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):([0-5][0-9])$",
            "title": "Breaktime"
          },
          "budget": {
            "type": "integer",
            "minimum": 10000.0,
            "title": "Budget"
          },
          "calories": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AnyCalories"
              },
              {
                "$ref": "#/components/schemas/AroundCalories"
              },
              {
                "$ref": "#/components/schemas/UnderCalories"
              },
              {
                "$ref": "#/components/schemas/FitCalories"
              }
            ],
            "title": "Calories",
            "discriminator": {
              "propertyName": "mode",
              "mapping": {
                "any": "#/components/schemas/AnyCalories",
                "around": "#/components/schemas/AroundCalories",
                "fit": "#/components/schemas/FitCalories",
                "under": "#/components/schemas/UnderCalories"
              }
            }
          },
          "exclusions": {
            "items": {
              "type": "string",
              "enum": [
                "chicken",
                "beef",
                "fish",
                "nuts",
                "dairy"
              ]
            },
            "type": "array",
            "title": "Exclusions"
          }
        },
        "type": "object",
        "required": [
          "workplace",
          "breakTime",
          "budget",
          "calories",
          "exclusions"
        ],
        "title": "UserPrefs",
        "description": "What onboarding collects and «حسابي» edits (userPrefsSchema)."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Workplace": {
        "properties": {
          "name": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "area": {
            "$ref": "#/components/schemas/LocalizedText"
          },
          "point": {
            "$ref": "#/components/schemas/GeoPoint"
          },
          "details": {
            "type": "string",
            "maxLength": 120,
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "name",
          "area",
          "point",
          "details"
        ],
        "title": "Workplace",
        "description": "Where lunch goes: a point on the map, its name in both languages, and the courier's notes."
      }
    }
  }
}
